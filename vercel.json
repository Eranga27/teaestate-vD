{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/submit_enquiry.php",
      "destination": "/api/enquiry"
    },
    {
      "source": "/submit_waitlist.php",
      "destination": "/api/waitlist"
    },
    {
      "source": "/api/github/:path*",
      "destination": "/api/cms-github?_gh=:path*"
    }
  ]
}
